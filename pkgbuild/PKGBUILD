# Maintainer: Tales A. Mendonça <talesam@gmail.com>

pkgname=big-gnome-center
pkgdesc="Manage the BigLinux GNOME desktop"
depends=(
    # Runtime
    'python'
    'python-gobject'
    'gtk4'
    'libadwaita'
    'gnome-shell'
    'polkit'
    # GNOME Shell extensions used by the bundled layouts
    'gnome-shell-big-shot'
    'gnome-shell-extension-appindicator'
    'gnome-shell-extension-copyous'
    'gnome-shell-extension-gtk4-desktop-icons-ng'
    'gnome-shell-extension-legacy-theme-auto-switcher'
)
makedepends=('git')
checkdepends=('python-pytest')
#optdepends=('')
conflicts=('layout-switcher' 'gnome-layout-switcher')
provides=('layout-switcher' 'gnome-layout-switcher')
replaces=('layout-switcher' 'gnome-layout-switcher')
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('MIT' 'GPL-2.0-or-later' 'GPL-3.0-or-later' 'CC-BY-4.0')
url="https://github.com/big-comm/big-gnome-center"
source=("${pkgname}::git+${url}.git")
md5sums=('SKIP')

# Automatically detect and use the correct install file
if [ -e "${pkgname}.install" ]; then
    install=${pkgname}.install
elif [ -e "pkgbuild.install" ]; then
    install=pkgbuild.install
fi

prepare() {
    cd "${srcdir}/${pkgname}"
    # Add any preparation steps here, if needed
    # For example: patch -p1 < "${srcdir}/patch-file.patch"
}

build() {
    cd "${srcdir}/${pkgname}"
    # Add build steps here, if needed
    # For example: make
}

check() {
    cd "${srcdir}/${pkgname}"
    python -m pytest -q
}

package() {
    cd "${srcdir}/${pkgname}"

    # Determine the correct source directory.
    # Use a local var — sobrescrever ${srcdir} (gerenciado pelo makepkg) quebra
    # builds incrementais e qualquer convenção de empacotamento.
    local pkgsrc
    if [ -d "${pkgname}" ]; then
        pkgsrc="${srcdir}/${pkgname}/${pkgname}"
    else
        pkgsrc="${srcdir}/${pkgname}"
    fi

    # Install files
    local dirs=("usr" "etc" "opt")
    for dir in "${dirs[@]}"; do
        if [ -d "${pkgsrc}/${dir}" ]; then
            cp -a "${pkgsrc}/${dir}" "${pkgdir}/"
        fi
    done

    # Pacman cannot replace an installed directory with a symlink.
    # Keep legacy directories and link individual files after packaging.
    local legacy="${pkgdir}/usr/share/layout-switcher"
    unlink "${legacy}"
    install -dm755 "${legacy}"

    # Keep one schema source in the extension; expose it to the GTK app.
    install -Dm644 \
        "${pkgsrc}/usr/share/gnome-shell/extensions/frosted-glass@communitybig.org/schemas/org.communitybig.frosted-glass.gschema.xml" \
        "${pkgdir}/usr/share/glib-2.0/schemas/org.communitybig.frosted-glass.gschema.xml"
    glib-compile-schemas \
        "${pkgdir}/usr/share/gnome-shell/extensions/frosted-glass@communitybig.org/schemas"

    glib-compile-schemas \
        "${pkgdir}/usr/share/gnome-shell/extensions/community-dock@communitybig.org/schemas"

    glib-compile-schemas \
        "${pkgdir}/usr/share/gnome-shell/extensions/community-panel@communitybig.org/schemas"

    local locale
    while read -r locale; do
        install -dm755 \
            "${pkgdir}/usr/share/locale/${locale}/LC_MESSAGES"
        msgfmt --check --output-file="${pkgdir}/usr/share/locale/${locale}/LC_MESSAGES/community-menu.mo" \
            "${pkgsrc}/usr/share/gnome-shell/extensions/community-menu@communitybig.org/po/${locale}.po"
    done < "${pkgsrc}/usr/share/gnome-shell/extensions/community-menu@communitybig.org/po/LINGUAS"

    # Install license file if present
    if [ -f "${pkgsrc}/LICENSE" ]; then
        install -Dm644 "${pkgsrc}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi
    install -Dm644 \
        "${pkgsrc}/usr/share/gnome-shell/extensions/community-menu@communitybig.org/COPYING" \
        "${pkgdir}/usr/share/licenses/${pkgname}/GPL-2.0-or-later.txt"
    install -Dm644 \
        "${pkgsrc}/usr/share/gnome-shell/extensions/community-dock@communitybig.org/COPYING" \
        "${pkgdir}/usr/share/licenses/${pkgname}/community-dock-GPL-2.0.txt"
    install -Dm644 \
        "${pkgsrc}/usr/share/gnome-shell/extensions/community-panel@communitybig.org/COPYING" \
        "${pkgdir}/usr/share/licenses/${pkgname}/community-panel-GPL-2.0.txt"

    # Install documentation if present
    if [ -f "${pkgsrc}/README.md" ]; then
        install -Dm644 "${pkgsrc}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    fi
    install -Dm644 \
        "${pkgsrc}/usr/share/gnome-shell/extensions/community-menu@communitybig.org/UPSTREAM.md" \
        "${pkgdir}/usr/share/doc/${pkgname}/community-menu-upstream.md"

    local file relative target
    while IFS= read -r -d '' file; do
        relative="${file#"${pkgdir}/usr/share/${pkgname}/"}"
        target="${legacy}/${relative}"
        install -dm755 "$(dirname "${target}")"
        ln -s "$(realpath --relative-to="$(dirname "${target}")" "${file}")" "${target}"
    done < <(find "${pkgdir}/usr/share/${pkgname}" -type f -print0)
}
