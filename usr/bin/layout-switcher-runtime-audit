#!/usr/bin/env bash
# Read-only audit for the active Layout Switcher Shell runtime.

set -euo pipefail

APP_DIR="/usr/share/layout-switcher"
if [[ ! -f "${APP_DIR}/runtime_audit.py" ]]; then
    SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
    APP_DIR="${SCRIPT_DIR}/../share/layout-switcher"
fi

exec python3 "${APP_DIR}/runtime_audit.py" "$@"
