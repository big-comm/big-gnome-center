#!/usr/bin/env bash
# Read-only audit for the active Big Gnome Center Shell runtime.

set -euo pipefail

APP_DIR="/usr/share/big-gnome-center"
if [[ ! -f "${APP_DIR}/runtime_audit.py" ]]; then
    SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
    APP_DIR="${SCRIPT_DIR}/../share/big-gnome-center"
fi

exec python3 "${APP_DIR}/runtime_audit.py" "$@"
