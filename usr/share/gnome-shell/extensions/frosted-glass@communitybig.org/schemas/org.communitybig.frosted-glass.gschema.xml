<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared by the Shell extension and Layout Switcher's GTK controls. -->
<schemalist gettext-domain="layout-switcher">
  <schema id="org.communitybig.frosted-glass" path="/org/communitybig/frosted-glass/">
    <key name="enabled" type="b">
      <default>false</default>
      <summary>Enable frosted glass</summary>
    </key>
    <key name="windows-enabled" type="b">
      <default>false</default>
      <summary>Blur application windows</summary>
    </key>
    <key name="panel-enabled" type="b">
      <default>true</default>
      <summary>Blur the top panel and Community Panel</summary>
    </key>
    <key name="dock-enabled" type="b">
      <default>true</default>
      <summary>Blur Community Dock</summary>
    </key>
    <key name="layout-menus-enabled" type="b">
      <default>true</default>
      <summary>Blur Community Menu surfaces</summary>
    </key>
    <key name="quick-settings-enabled" type="b">
      <default>true</default>
      <summary>Blur GNOME Quick Settings</summary>
    </key>
    <key name="calendar-enabled" type="b">
      <default>true</default>
      <summary>Blur the calendar and notifications menu</summary>
    </key>
    <key name="system-dialogs-enabled" type="b">
      <default>true</default>
      <summary>Blur GNOME Shell system dialogs</summary>
    </key>
    <key name="overview-enabled" type="b">
      <default>true</default>
      <summary>Blur the workspace and application overview</summary>
    </key>
    <key name="blur-strength" type="i">
      <range min="0" max="100"/>
      <default>23</default>
      <summary>Blur strength</summary>
    </key>
    <key name="glass-opacity" type="i">
      <range min="0" max="100"/>
      <default>37</default>
      <summary>Material opacity</summary>
    </key>
    <key name="use-accent-color" type="b">
      <default>false</default>
      <summary>Use the Shell accent color for the glass material</summary>
    </key>
    <key name="blur-mode" type="s">
      <choices>
        <choice value="automatic"/>
        <choice value="dynamic"/>
        <choice value="static"/>
      </choices>
      <default>'automatic'</default>
      <summary>Blur rendering mode</summary>
    </key>
    <key name="application-exclusions" type="as">
      <default>[]</default>
      <summary>Window classes and application IDs excluded from blur</summary>
    </key>
    <key name="maximized-behavior" type="s">
      <choices>
        <choice value="keep"/>
        <choice value="opaque"/>
        <choice value="disable"/>
      </choices>
      <default>'keep'</default>
      <summary>Behavior for maximized windows</summary>
    </key>
    <key name="fullscreen-behavior" type="s">
      <choices>
        <choice value="keep"/>
        <choice value="opaque"/>
        <choice value="disable"/>
      </choices>
      <default>'disable'</default>
      <summary>Behavior for fullscreen windows</summary>
    </key>
    <key name="power-save-behavior" type="s">
      <choices>
        <choice value="keep"/>
        <choice value="static"/>
        <choice value="disable"/>
      </choices>
      <default>'static'</default>
      <summary>Behavior on battery or in power saver mode</summary>
    </key>
  </schema>
</schemalist>
