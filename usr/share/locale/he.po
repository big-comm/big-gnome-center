msgstr "מציג סמלי יישומים בלוח המערכת."

#: usr/share/layout-switcher/ui/page_extensions.py:40
msgid "Provides application launchers and running windows in a dock."
msgstr "מספק מפעילי יישומים וחלונות פעילים במעגן."

#: usr/share/layout-switcher/ui/page_extensions.py:43
msgid "Provides the applications menu used by desktop layouts."
msgstr "מספק את תפריט היישומים שבו משתמשות פריסות שולחן העבודה."

#: usr/share/layout-switcher/ui/page_extensions.py:46
msgid "Provides the taskbar and system panel used by desktop layouts."
msgstr "מספק את שורת המשימות ולוח המערכת שבהם משתמשות הפריסות."

#: usr/share/layout-switcher/ui/page_extensions.py:49
msgid "Keeps a searchable history of copied content."
msgstr "שומר היסטוריה ניתנת לחיפוש של תוכן שהועתק."

#: usr/share/layout-switcher/ui/page_extensions.py:52
msgid "Shows removable devices and lets you safely eject them."
msgstr "מציג התקנים נשלפים ומאפשר להוציא אותם בבטחה."

#: usr/share/layout-switcher/ui/page_extensions.py:55
msgid "Adds controlled blur and transparency to the desktop."
msgstr "מוסיף טשטוש ושקיפות מבוקרים לשולחן העבודה."

#: usr/share/layout-switcher/ui/page_extensions.py:58
msgid "Connects phones to share files, notifications and other features."
msgstr "מחבר טלפונים לשיתוף קבצים, התראות ותכונות נוספות."

#: usr/share/layout-switcher/ui/page_extensions.py:61
msgid "Shows files and folders on the desktop."
msgstr "מציג קבצים ותיקיות בשולחן העבודה."

#: usr/share/layout-switcher/ui/page_extensions.py:64
msgid "Applies layout changes safely inside GNOME Shell."
msgstr "מחיל שינויי פריסה בבטחה בתוך GNOME Shell."

#: usr/share/layout-switcher/ui/page_extensions.py:67
msgid "Provides the dock and taskbar runtime used by desktop layouts."
msgstr "מספק את סביבת הריצה של המעגן ושורת המשימות לפריסות."

#: usr/share/layout-switcher/ui/page_extensions.py:70
msgid "Keeps GTK 3 applications aligned with light and dark mode."
msgstr "שומר על יישור יישומי GTK 3 עם מצב בהיר וכהה."

#: usr/share/layout-switcher/ui/page_extensions.py:73
msgid "Uses the light GNOME Shell appearance."
msgstr "משתמש במראה הבהיר של GNOME Shell."

#: usr/share/layout-switcher/ui/page_extensions.py:76
msgid "Loads the Shell theme selected by the active layout."
msgstr "טוען את ערכת הנושא של Shell שנבחרה בפריסה הפעילה."

#: usr/share/layout-switcher/ui/page_extensions.py:91
msgid "Description not provided by the developer."
msgstr "המפתח לא סיפק תיאור."

