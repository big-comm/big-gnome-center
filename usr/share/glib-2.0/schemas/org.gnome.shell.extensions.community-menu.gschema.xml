<schemalist gettext-domain="community-menu">
  <enum id="org.gnome.shell.extensions.community-menu.layouts">
    <value value="0" nick="ALL"/>
    <value value="1" nick="APPS_ONLY"/>
    <value value="2" nick="SYSTEM_ONLY"/>
    <value value="3" nick="APP_GRID"/>
    <value value="4" nick="MINT"/>
  </enum>
  <schema path="/org/gnome/shell/extensions/community-menu/"
          id="org.gnome.shell.extensions.community-menu">
    <key name="layout" enum="org.gnome.shell.extensions.community-menu.layouts">
      <default>'MINT'</default>
      <summary>Layout</summary>
      <description>The layout of the Community Menu popup.</description>
    </key>
    <key name="desktop-layout" type="s">
      <default>''</default>
      <summary>Active desktop layout</summary>
      <description>The active Big Gnome Center desktop layout, independent of the menu appearance.</description>
    </key>
    <key name="super-key-opens-menu" type="b">
      <default>true</default>
      <summary>Open the menu with Super</summary>
      <description>Open Community Menu instead of the overview when pressing Super.</description>
    </key>
  </schema>
  <!-- Personal app order must survive layout-owned extension resets. -->
  <schema path="/org/communitybig/community-menu/pins/"
          id="org.gnome.shell.extensions.community-menu.pins">
    <key name="apps" type="as">
      <default>[]</default>
      <summary>Pinned menu applications</summary>
      <description>Ordered application IDs, independent of GNOME Shell favorites.</description>
    </key>
  </schema>
  <schema path="/org/communitybig/community-menu/folders/"
          id="org.gnome.shell.extensions.community-menu.folders">
    <key name="colors" type="a{ss}">
      <default>{}</default>
      <summary>Folder accent colors</summary>
      <description>Optional menu colors keyed by native GNOME folder ID.</description>
    </key>
  </schema>
</schemalist>
